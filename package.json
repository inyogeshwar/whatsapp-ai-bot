{
  "name": "whatsapp-ai-bot",
  "version": "1.0.0",
  "description": "Secure, modular WhatsApp bot built on @whiskeysockets/baileys v7 — commands, group moderation, persistent settings, optional local AI (Ollama).",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "keep-alive": "node scripts/keep-alive.js",
    "test": "node --test"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "baileys-v7",
    "moderation",
    "ollama"
  ],
  "license": "MIT",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
}
