# ─────────────────────────────────────────────────────────────
# WhatsApp AI Bot — environment configuration
# Copy this file to `.env` and fill in your values.
# NEVER commit the real `.env` file or share its contents.
# ─────────────────────────────────────────────────────────────

# Display name of the bot (shown in .alive and .menu)
BOT_NAME=My WhatsApp Bot

# Owner display name (shown in .owner)
BOT_OWNER_NAME=Bot Owner

# Owner WhatsApp identifier (JID). Leave empty to disable owner-only commands.
# Accepts any of these formats — it is normalized at startup:
#   1234567890            → 1234567890@s.whatsapp.net  (phone number, include country code)
#   1234567890@s.whatsapp.net                            (full phone-number JID)
#   123456789012345@lid                                 (full LID — works too)
BOT_OWNER_JID=

# Command prefix (single character)
BOT_PREFIX=.

# Log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Optional: also write the login QR to this local image file (useful when the
# bot runs in the background/pm2/VPS and you can't see the terminal QR).
# Git-ignored by default. The file is DELETED automatically after login.
# Only used when LOGIN_METHOD=qr.
# QR_IMAGE_PATH=qr.png

# ── Login method ──────────────────────────────────────────────
# qr      → scan a QR code (default)
# pairing → enter an 8-digit code in WhatsApp > Linked Devices > Link with
#           phone number. More stable than QR; avoids repeated re-scans,
#           which are the usual cause of "device_removed" (401) logouts.
#           Requires PAIRING_NUMBER. Code is valid for ~2 minutes.
LOGIN_METHOD=qr
# Required when LOGIN_METHOD=pairing. Digits with country code, no + or spaces.
# Example: 15551234567
PAIRING_NUMBER=

# ── Web tools (weather, dictionary, links) ────────────────────
# All use free keyless APIs. Set false to disable every network command.
WEB_ENABLED=true
WEB_TIMEOUT_MS=15000

# ── Sticker (.sticker) ────────────────────────────────────────
STICKER_MAX_BYTES=2000000
STICKER_AUTHOR=Yogesh Bot
STICKER_PACK=WhatsApp AI Bot

# ── AI (pick ONE provider; disabled by default) ───────────────
# Provider "ollama"  → local Ollama (https://ollama.com): ollama pull <model>,
#                      leave AI_API_KEY empty, AI_BASE_URL=http://127.0.0.1:11434
# Provider "openai"  → any OpenAI-compatible gateway (FreeLLMAPI, LM Studio,
#                      vLLM, llama.cpp --api, OpenAI): AI_API_KEY required,
#                      AI_BASE_URL points at the gateway (…:31415 etc.)
AI_ENABLED=false
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
# Bearer token for provider=openai. NEVER commit or share it.
AI_API_KEY=
# Model id the provider offers (e.g. llama3.2 for Ollama, gemini-3.5-flash
# or llama-3.3-70b for FreeLLMAPI). In WhatsApp, `.ai models` lists them.
AI_MODEL=

# AI limits (optional — sensible defaults apply if unset)
AI_MAX_INPUT=2000
AI_MAX_OUTPUT=4000
AI_TIMEOUT_MS=30000
AI_RATE_LIMIT=5
AI_RATE_WINDOW_SEC=60

# ── Rate limits (optional) ───────────────────────────────────
# Max commands per user per window
CMD_RATE_LIMIT=8
CMD_RATE_WINDOW_SEC=10
# Per-group cooldown for .tagall (seconds)
TAGALL_COOLDOWN_SEC=60
